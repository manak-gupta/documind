{
  "name": "@documind/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node src/server.ts",
    "worker": "node --watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node src/worker.ts",
    "demo": "node src/all-in-one.ts --demo",
    "migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "eval:generate": "node --env-file-if-exists=../../.env eval/generate.ts",
    "eval": "node --env-file-if-exists=../../.env eval/run.ts",
    "typecheck": "tsc",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
