# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://documind:documind@localhost:5432/documind

# --- Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# --- LLM + embeddings ---
# Provider is swappable by config. Free key: https://aistudio.google.com -> Get API key
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_FAST_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
# Fixed per deployment: it's the size of the vector column. Changing it = migration + re-embed.
EMBEDDING_DIM=768

# --- Cost guards ---
DAILY_TOKEN_BUDGET=200000
ASK_RATE_LIMIT_PER_MIN=20
